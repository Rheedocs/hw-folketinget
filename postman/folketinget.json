{
  "info": {
    "name": "Folketinget API",
    "description": "Tester CRUD for person endpoints i Folketinget API: oprettelse, hentning, opdatering og sletning samt validering og fejlhåndtering for ugyldige og ukendte id'er og ugyldig JSON. Kør collectionen samlet i Runner med serveren startet og seed kørt, da requests deler personId. baseUrl er API'ets adresse, og personId sættes af første request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST gyldig person (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status er 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response har _id\", function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json).to.have.property(\"_id\");",
              "});",
              "pm.test(\"name er Test Person\", function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.name).to.eql(\"Test Person\");",
              "});",
              "var json = pm.response.json();",
              "pm.collectionVariables.set(\"personId\", json._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Person\",\n  \"party\": \"Testpartiet\",\n  \"roles\": [{ \"position\": \"minister\", \"title\": \"Testminister\", \"startDate\": \"2024-01-01\" }]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        }
      },
      "response": []
    },
